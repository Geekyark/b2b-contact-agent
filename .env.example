# =====================================================================
# Agent 2 - B2B Decision-Maker Contact Finder - configuration
# Copy this file to `.env` and fill in your real values.
#   (Windows:  copy .env.example .env )
# =====================================================================

# ---- Claude (Anthropic) --------------------------------------------
# Required to run contact discovery (evidence extraction).
# Works with an API key, or an `ant auth login` profile (leave empty then).

# Model used for extraction. Configurable; must be available to your account.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_TOKENS=16000

# ---- Web search (discovery evidence) --------------------------------
# Options: tavily (production) | mock (no API key, deterministic sample data)
SEARCH_PROVIDER=tavily
TAVILY_MAX_RESULTS=8
MAX_QUERIES_PER_COMPANY=6
SEARCH_DELAY_SECONDS=0.2

# ---- Contact verification (optional, all disabled by default) -------
# Discovery and verification are separate. Without a configured provider,
# emails/phones found in sources are marked
# "published_in_source_not_independently_verified".
# Options: none | neverbounce | zerobounce
EMAIL_VERIFICATION_PROVIDER=none

# Options: none | abstract
PHONE_VERIFICATION_PROVIDER=none

# ---- Storage / output -----------------------------------------------
DATABASE_PATH=data/agent2.db
OUTPUT_DIR=data/output

# ---- FastAPI server (optional) --------------------------------------
API_HOST=127.0.0.1
API_PORT=8123